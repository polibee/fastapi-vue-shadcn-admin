{
  "name": "fastapi-vue-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "generate:sdk": "openapi-ts -i http://127.0.0.1:8012/openapi.json -o src/core/api/generated/client -c @hey-api/client-fetch",
    "generate:sdk:check": "node ../scripts/check-generated-sdk.mjs",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@lucide/vue": "^1.47.0",
    "@vueuse/core": "^13.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "pinia": "^3.0.3",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.2",
    "vue-router": "^4.5.0",
    "vue-sonner": "^2.0.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^26.6.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.7.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.10"
  }
}
