# Copy to .env and replace credentials/database names for local development.
DATABASE_URL=postgresql+asyncpg://app:secret@127.0.0.1:5432/fastapi_admin_dev
# DATABASE_URL=mysql+aiomysql://app:secret@127.0.0.1:3306/fastapi_admin_dev?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=change-me-in-development
JWT_ACCESS_TOKEN_MINUTES=60
API_DOCS_ENABLED=true

# P3.3 Middleware Foundation
REQUEST_ID_HEADER=X-Request-ID
CORS_ENABLED=false
# Use JSON arrays for list-valued settings.
CORS_ALLOW_ORIGINS=[]
CORS_ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["Authorization","Content-Type","X-Request-ID"]
CORS_ALLOW_CREDENTIALS=true
TRUSTED_HOSTS_ENABLED=false
TRUSTED_HOSTS=[]
JWT_REFRESH_TOKEN_MINUTES=10080
PASSWORD_MIN_LENGTH=8
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
API_RATE_LIMIT=120
API_RATE_WINDOW_SECONDS=60
